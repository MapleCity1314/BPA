{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpa.local/schemas/adapter-manifest/v1alpha1",
  "title": "BPA Adapter Manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "platform",
    "origins",
    "capabilities"
  ],
  "properties": {
    "apiVersion": { "const": "bpa.adapter/v1alpha1" },
    "kind": { "const": "Adapter" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 }
      }
    },
    "platform": { "$ref": "#/$defs/id" },
    "origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://[^/?#]+$"
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumVersion"],
      "properties": {
        "minimumVersion": { "$ref": "#/$defs/semver" }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "nodeVersions",
          "handlerId",
          "handlerVersion",
          "implementationDigest",
          "permissions"
        ],
        "properties": {
          "nodeId": { "$ref": "#/$defs/id" },
          "nodeVersions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/semver" }
          },
          "handlerId": { "$ref": "#/$defs/id" },
          "handlerVersion": { "$ref": "#/$defs/semver" },
          "implementationDigest": { "$ref": "#/$defs/digest" },
          "permissions": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
