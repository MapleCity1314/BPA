{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpa.local/schemas/authoring/session/v1alpha1",
  "title": "BPA Authoring Session v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "sessionId",
    "revision",
    "state",
    "scenarioRef",
    "actor",
    "catalogSelections",
    "capabilityGaps",
    "designGrantRefs",
    "snapshotRefs",
    "appliedOperationIds",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "apiVersion": { "const": "bpa.authoring/v1alpha1" },
    "kind": { "const": "AuthoringSession" },
    "sessionId": { "$ref": "#/$defs/id" },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "state": {
      "enum": [
        "intake",
        "catalog",
        "discovery",
        "modeling",
        "assembly",
        "validation",
        "candidate",
        "closed",
        "failed"
      ]
    },
    "scenarioRef": { "$ref": "#/$defs/versionedRef" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["ai", "human"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "catalogSelections": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/assetRef" }
    },
    "capabilityGaps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gapId",
          "capabilityId",
          "summary",
          "requiredInputs",
          "requiredOutputs",
          "maximumRisk",
          "status"
        ],
        "properties": {
          "gapId": { "$ref": "#/$defs/id" },
          "capabilityId": { "$ref": "#/$defs/id" },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "platform": { "$ref": "#/$defs/id" },
          "requiredInputs": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "requiredOutputs": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 300 }
          },
          "maximumRisk": { "$ref": "#/$defs/risk" },
          "status": { "enum": ["open", "resolved"] },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "reference", "resolvedAt"],
            "properties": {
              "kind": {
                "enum": ["catalog-entry", "recipe", "candidate"]
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "resolvedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "resolved" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "resolution": {
                  "type": "object"
                }
              },
              "required": ["resolution"]
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "open" } },
              "required": ["status"]
            },
            "then": { "not": { "required": ["resolution"] } }
          }
        ]
      }
    },
    "designGrantRefs": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "snapshotRefs": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/contentRef" }
    },
    "candidateBundleRef": { "$ref": "#/$defs/contentRef" },
    "appliedOperationIds": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": { "enum": ["candidate", "closed"] }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "candidateBundleRef": {
            "$ref": "#/$defs/contentRef"
          }
        },
        "required": ["candidateBundleRef"]
      }
    }
  ],
  "$defs": {
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetType", "id", "version", "digest", "status"],
      "properties": {
        "assetType": {
          "enum": [
            "node",
            "workflow",
            "adapter",
            "policy",
            "assistance_profile",
            "dataset_profile",
            "page_model",
            "element_contract"
          ]
        },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["candidate", "published"] }
      }
    },
    "versionedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "risk": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 160
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
