{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpa.local/schemas/trigger-spec/v1alpha2",
  "title": "BPATriggerSpecV1Alpha2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "version",
    "appId",
    "kind",
    "workflow",
    "enabled",
    "inputSchemaVersion",
    "input",
    "concurrencyKey",
    "idempotencyPolicy",
    "retryPolicy"
  ],
  "properties": {
    "apiVersion": { "const": "bpa.trigger/v1alpha2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "appId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["manual", "schedule", "dataset"] },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "enabled": { "type": "boolean" },
    "inputSchemaVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "input": { "type": "object" },
    "concurrencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "browserInstanceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotencyPolicy": { "enum": ["occurrence", "dataset_version", "request_key"] },
    "retryPolicy": { "const": "none" },
    "missedRunPolicy": { "enum": ["skip", "run_once", "bounded_catch_up"] },
    "maxCatchUpOccurrences": { "type": "integer", "minimum": 1, "maximum": 24 },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "timezone", "localTime", "onTimeWindowSeconds"],
          "properties": {
            "type": { "const": "daily" },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^(?:UTC|[A-Za-z_]+(?:/[A-Za-z0-9._+-]+)+)$"
            },
            "localTime": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "onTimeWindowSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "anchorAt", "intervalSeconds", "onTimeWindowSeconds"],
          "properties": {
            "type": { "const": "interval" },
            "anchorAt": { "type": "string", "format": "date-time" },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800
            },
            "onTimeWindowSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 604800
            }
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "schedule" } } },
      "then": {
        "required": ["schedule", "missedRunPolicy"],
        "properties": {
          "schedule": {},
          "missedRunPolicy": {},
          "idempotencyPolicy": { "const": "occurrence" },
          "retryPolicy": { "const": "none" }
        }
      },
      "else": {
        "properties": {
          "schedule": false,
          "missedRunPolicy": false,
          "maxCatchUpOccurrences": false
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "dataset" } } },
      "then": {
        "required": ["dataset"],
        "properties": { "dataset": {} }
      }
    },
    {
      "if": {
        "required": ["missedRunPolicy"],
        "properties": { "missedRunPolicy": { "const": "bounded_catch_up" } }
      },
      "then": { "required": ["maxCatchUpOccurrences"] },
      "else": { "properties": { "maxCatchUpOccurrences": false } }
    }
  ]
}
