{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpa.local/schemas/trigger-spec/v1",
  "title": "BPATriggerSpecV1Alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "version",
    "appId",
    "kind",
    "workflow",
    "enabled",
    "inputSchemaVersion",
    "input",
    "concurrencyKey",
    "idempotencyPolicy",
    "retryPolicy"
  ],
  "properties": {
    "apiVersion": { "const": "bpa.trigger/v1alpha1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "appId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "enum": ["manual", "schedule", "dataset"] },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "enabled": { "type": "boolean" },
    "inputSchemaVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "input": { "type": "object" },
    "concurrencyKey": { "type": "string", "minLength": 1, "maxLength": 256 },
    "browserInstanceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "idempotencyPolicy": { "enum": ["occurrence", "dataset_version", "request_key"] },
    "retryPolicy": { "enum": ["none", "safe_once"] },
    "missedRunPolicy": { "enum": ["skip", "run_once", "bounded_catch_up"] },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervalSeconds"],
      "properties": {
        "intervalSeconds": { "type": "integer", "minimum": 60, "maximum": 604800 },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "schedule" } } },
      "then": {
        "required": ["schedule", "missedRunPolicy"],
        "properties": { "schedule": {}, "missedRunPolicy": {} }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "dataset" } } },
      "then": {
        "required": ["dataset"],
        "properties": { "dataset": {} }
      }
    }
  ]
}
