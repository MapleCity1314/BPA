{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpa.local/schemas/deterministic-result-validator-policy/v1alpha1",
  "title": "BPA Deterministic Result Validator Policy v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "implementation"],
  "properties": {
    "apiVersion": { "const": "bpa.policy/v1alpha1" },
    "kind": { "const": "DeterministicResultValidatorPolicy" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "title"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/semver" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 4000 }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "validator",
        "maxBatchItems",
        "maxCandidatesPerItem",
        "constraints"
      ],
      "properties": {
        "provider": { "const": "builtin" },
        "validator": { "$ref": "#/$defs/id" },
        "maxBatchItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxCandidatesPerItem": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    }
  }
}
