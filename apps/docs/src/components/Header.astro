---
import Search from "@astrojs/starlight/components/Search.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import SiteTitle from "./SiteTitle.astro";

const base = import.meta.env.BASE_URL;
---

<div class="bpa-header">
  <div class="bpa-header__brand">
    <SiteTitle siteTitleHref={base} />
  </div>
  <nav class="bpa-header__nav" aria-label="主要导航">
    <a href={`${base}guides/operator-console/`}>指南</a>
    <a href={`${base}platform/architecture/`}>架构</a>
    <a href={`${base}browser/v1/`}>协议</a>
    <a href={`${base}reference/schemas/`}>参考</a>
  </nav>
  <div class="bpa-header__search">
    <Search />
  </div>
  <div class="bpa-header__actions">
    <div class="bpa-header__social">
      <SocialIcons />
    </div>
    <ThemeSelect />
  </div>
</div>
