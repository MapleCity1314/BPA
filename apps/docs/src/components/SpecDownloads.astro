---
const base = import.meta.env.BASE_URL;
const specs = [
  ["browser-protocol-v1.schema.json", "Browser Protocol v1", "v1"],
  ["permission.schema.json", "Signed Permission Grant", "v1"],
  ["timing-policy.schema.json", "Timing Policy", "v1"],
  ["risk-signal.schema.json", "Risk Signal", "v1"],
  ["workflow.schema.json", "Workflow", "v1alpha1"],
  ["workflow-v1alpha2.schema.json", "Structured Workflow", "v1alpha2"],
  ["workflow-v1alpha3.schema.json", "Resource-aware Workflow", "v1alpha3"],
  ["node.schema.json", "Node Definition", "v1alpha1"],
  ["node-v1alpha2.schema.json", "Resource-aware Node", "v1alpha2"],
  ["event.schema.json", "Execution Event", "v1"],
  ["evidence.schema.json", "Evidence Metadata", "v1"],
  ["source-record.schema.json", "Source Record", "v1alpha1"],
  ["asset-record.schema.json", "Asset Record", "v1alpha1"],
  ["evidence-link.schema.json", "Evidence Link", "v1alpha1"],
  ["assistance-task.schema.json", "Assistance Task", "v1alpha1"],
  ["dataset.schema.json", "Dataset Version", "v1alpha1"],
  ["decision-record.schema.json", "Decision Record", "v1alpha1"],
  ["page-model.schema.json", "Page Model", "v1alpha1"],
  ["element-contract.schema.json", "Element Contract", "v1alpha1"]
] as const;
---

<div class="spec-list">
  <div class="spec-list__row spec-list__head" aria-hidden="true">
    <span>规范</span><span>状态</span><span>文件</span>
  </div>
  {
    specs.map(([file, label, version]) => (
      <div class="spec-list__row">
        <span>{label}</span>
        <code>{version}</code>
        <a href={`${base}specs/${file}`} download>{file}</a>
      </div>
    ))
  }
</div>
