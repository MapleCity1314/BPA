{
  "name": "bpa",
  "version": "0.6.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "runtime:check": "node scripts/assert-node24.mjs",
    "prebuild": "pnpm runtime:check",
    "build": "tsc -p tsconfig.build.json && pnpm --filter @bpa/extension build && pnpm --filter @bpa/operator-console build && pnpm --filter @bpa/console-host build",
    "pretypecheck": "pnpm runtime:check",
    "typecheck": "tsc --noEmit && pnpm --filter @bpa/extension typecheck && pnpm --filter @bpa/operator-console build && pnpm --filter @bpa/console-host typecheck",
    "pretest": "pnpm runtime:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "node scripts/generate-schema-types.mjs",
    "schema:check": "node scripts/generate-schema-types.mjs --check",
    "repository:check": "node scripts/verify-repository.mjs",
    "architecture:check": "node scripts/verify-architecture-boundaries.mjs",
    "supply-chain:check": "node scripts/verify-supply-chain.mjs",
    "performance:check": "tsx scripts/verify-persistence-scale.ts",
    "runtime:analyze": "node scripts/analyze-macos-runtime-metrics.mjs",
    "runtime:gate": "node scripts/analyze-macos-runtime-metrics.mjs --require-complete",
    "runtime:stability-gate": "node scripts/analyze-macos-runtime-metrics.mjs --require-stable",
    "native:build": "pnpm --filter @bpa/inventory-kernel build:release",
    "native:test": "pnpm --filter @bpa/inventory-kernel test",
    "native:check": "pnpm --filter @bpa/inventory-kernel lint && pnpm native:build && pnpm native:test && pnpm sqlite-observability:check",
    "native:benchmark": "pnpm --filter @bpa/inventory-kernel benchmark",
    "sqlite-observability:check": "node scripts/check-sqlite-observability.mjs",
    "scripts:check": "node scripts/check-scripts.mjs",
    "docs:dev": "pnpm --filter @bpa/docs dev",
    "docs:build": "pnpm --filter @bpa/docs build",
    "docs:preview": "pnpm --filter @bpa/docs preview",
    "docs:check": "pnpm --filter @bpa/docs check",
    "package:windows": "BPA_BUNDLED_NODE=${BPA_BUNDLED_NODE:-$(command -v node)} ./scripts/package-windows-x64.sh",
    "package:doudian-alliance-skill": "node scripts/package-doudian-alliance-skill.mjs",
    "verify:doudian-alliance-skill": "node scripts/verify-doudian-alliance-skill.mjs --source",
    "prebpa": "pnpm runtime:check",
    "console:build": "pnpm --filter @bpa/operator-console build && pnpm --filter @bpa/console-host build",
    "console:ui": "pnpm --filter @bpa/operator-console dev",
    "console:host": "pnpm console:build && pnpm --filter @bpa/console-host start",
    "bpa": "BPA_CONSOLE_HOST_ENTRY=apps/console-host/src/main.ts tsx apps/cli/src/main.ts",
    "precore": "pnpm runtime:check && pnpm sqlite-observability:check",
    "core": "tsx apps/local-core/src/main.ts",
    "prenative-host": "pnpm runtime:check",
    "native-host": "tsx apps/native-host/src/main.ts",
    "premcp": "pnpm runtime:check",
    "mcp": "tsx apps/mcp-server/src/main.ts",
    "check": "pnpm repository:check && pnpm architecture:check && pnpm scripts:check && pnpm supply-chain:check && pnpm native:check && pnpm typecheck && pnpm test",
    "verify": "pnpm schema:check && pnpm check && pnpm build && pnpm docs:check"
  },
  "dependencies": {
    "@bpa/compiler": "workspace:*",
    "@bpa/attention-core": "workspace:*",
    "@bpa/control-protocol": "workspace:*",
    "@bpa/engine": "workspace:*",
    "@bpa/node-runtime": "workspace:*",
    "@bpa/page-readiness": "workspace:*",
    "@bpa/interaction-policy": "workspace:*",
    "@bpa/operator-read-model": "workspace:*",
    "@bpa/platform-runtime": "workspace:*",
    "@bpa/persistence": "workspace:*",
    "@bpa/persistence-sqlite": "workspace:*",
    "@bpa/schemas": "workspace:*",
    "@bpa/workflow-ir": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "12.10.0",
    "commander": "^14.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "esbuild": "0.28.1",
    "json-schema-to-typescript": "^15.0.4",
    "postject": "1.0.0-alpha.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
