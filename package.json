{
  "name": "bpa",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter @bpa/extension build",
    "typecheck": "tsc --noEmit && pnpm --filter @bpa/extension typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:generate": "node scripts/generate-schema-types.mjs",
    "schema:check": "node scripts/generate-schema-types.mjs --check",
    "docs:dev": "pnpm --filter @bpa/docs dev",
    "docs:build": "pnpm --filter @bpa/docs build",
    "docs:preview": "pnpm --filter @bpa/docs preview",
    "docs:check": "pnpm --filter @bpa/docs check",
    "bpa": "tsx apps/cli/src/main.ts",
    "core": "tsx apps/local-core/src/main.ts",
    "native-host": "tsx apps/native-host/src/main.ts",
    "mcp": "tsx apps/mcp-server/src/main.ts",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@bpa/compiler": "workspace:*",
    "@bpa/engine": "workspace:*",
    "@bpa/persistence": "workspace:*",
    "@bpa/persistence-sqlite": "workspace:*",
    "@bpa/schemas": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "12.10.0",
    "commander": "^14.0.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
