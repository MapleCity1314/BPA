{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpa.local/schemas/docs-catalog-v1.schema.json",
  "title": "BPA Documentation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "bpa.docs-catalog/1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "title",
        "summary",
        "authority",
        "implementation",
        "audience",
        "public"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
        "source": { "type": "string", "pattern": "^(docs|apps/docs/src/content/docs)/.+\\.mdx?$" },
        "route": { "type": "string", "pattern": "^(|[a-z0-9][a-z0-9./-]*)$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "authority": {
          "enum": [
            "current-state",
            "normative",
            "architecture",
            "operations",
            "tutorial",
            "plan",
            "research",
            "historical"
          ]
        },
        "implementation": {
          "enum": ["active", "partial", "planned", "deprecated", "superseded"]
        },
        "audience": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["operator", "developer", "integrator", "ai"] }
        },
        "since": { "type": "string", "minLength": 1 },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "public": { "type": "boolean" },
        "navigationGroup": { "type": "string", "minLength": 1 },
        "navigationOrder": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
